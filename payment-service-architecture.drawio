        <mxCell id="auth" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#FFE6CC,#FFF3E0);strokeColor=#d79b00;fontColor=light-dark(#000000,#000000);fontSize=14;arcSize=8;" value="Bearer MERCHANT_API_KEY&#xa;(required on all merchant APIs)" vertex="1">
          <mxGeometry height="60" width="260" x="680" y="190" as="geometry" />
        </mxCell>
        <mxCell id="apiBox" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=light-dark(#FFF2CC,#FFF9CC);strokeColor=#d6b656;fontColor=light-dark(#000000,#000000);fontSize=14;arcSize=6;" value="&lt;b&gt;Public API&lt;/b&gt;&lt;br&gt;GET /health&lt;br&gt;POST /payments&lt;br&gt;GET /payments/:id&lt;br&gt;POST /payments/:id/refunds&lt;br&gt;POST /admin/reset &lt;i&gt;(TEST_MODE)&lt;/i&gt;" vertex="1">
          <mxGeometry height="120" width="260" x="680" y="288" as="geometry" />
        </mxCell>
        <mxCell id="payments" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=light-dark(#FFF2CC,#FFF9CC);strokeColor=#d6b656;fontColor=light-dark(#000000,#000000);fontSize=14;arcSize=6;" value="&lt;b&gt;payments/&lt;/b&gt;&lt;br&gt;• Create pending payment&lt;br&gt;• Idempotency keys&lt;br&gt;• State machine&lt;br&gt;• One active payment / order" vertex="1">
          <mxGeometry height="109" width="240" x="1026" y="275" as="geometry" />
        </mxCell>
        <mxCell id="refunds" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=light-dark(#FFF2CC,#FFF9CC);strokeColor=#d6b656;fontColor=light-dark(#000000,#000000);fontSize=14;arcSize=6;" value="&lt;b&gt;refunds/&lt;/b&gt;&lt;br&gt;• Full / partial refunds&lt;br&gt;• Balance reservation&lt;br&gt;• Idempotent creates" vertex="1">
          <mxGeometry height="86" width="220" x="1280" y="177" as="geometry" />
        </mxCell>
        <mxCell id="providers" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=light-dark(#FFF2CC,#FFF9CC);strokeColor=#d6b656;fontColor=light-dark(#000000,#000000);fontSize=14;arcSize=6;" value="&lt;b&gt;providers/&lt;/b&gt;&lt;br&gt;PaymentProvider interface&lt;br&gt;• initialize transaction&lt;br&gt;• verify transaction&lt;br&gt;• create refund&lt;br&gt;&lt;i&gt;(Paystack is the only impl)&lt;/i&gt;" vertex="1">
          <mxGeometry height="127" width="240" x="1480" y="320" as="geometry" />
        </mxCell>
        <mxCell id="webhooks" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=light-dark(#FFE6CC,#FFF3E0);strokeColor=#d79b00;fontColor=light-dark(#000000,#000000);fontSize=14;arcSize=6;" value="&lt;b&gt;webhooks/&lt;/b&gt;&lt;br&gt;POST /webhooks/paystack&lt;br&gt;• HMAC-SHA512 signature&lt;br&gt;• Event dedup key&lt;br&gt;• charge.success&lt;br&gt;• refund.processed / failed&lt;br&gt;• Verify before state change" vertex="1">
          <mxGeometry height="143" width="250" x="1475" y="510" as="geometry" />
        </mxCell>
        <mxCell id="callbacks" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=light-dark(#FFF2CC,#FFF9CC);strokeColor=#d6b656;fontColor=light-dark(#000000,#000000);fontSize=14;arcSize=6;" value="&lt;b&gt;callbacks/&lt;/b&gt;&lt;br&gt;Outbox + retry worker&lt;br&gt;• payment.succeeded&lt;br&gt;• payment.expired&lt;br&gt;• payment.refunded&lt;br&gt;• payment.refund_failed&lt;br&gt;HMAC-SHA256 signed&lt;br&gt;Exponential backoff (≥6)" vertex="1">
          <mxGeometry height="163" width="204" x="673" y="534" as="geometry" />
        </mxCell>
        <mxCell id="jobs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=light-dark(#FFF2CC,#FFF9CC);strokeColor=#d6b656;fontColor=light-dark(#000000,#000000);fontSize=14;arcSize=6;" value="&lt;b&gt;jobs/&lt;/b&gt;&lt;br&gt;Expiry &amp;amp; reconciliation&lt;br&gt;• Pending &amp;gt; TIMEOUT → verify&lt;br&gt;• Success → succeeded&lt;br&gt;• Else → expired&lt;br&gt;• Late transfer: expired →&lt;br&gt;&amp;nbsp;&amp;nbsp;succeeded (late: true)" vertex="1">
          <mxGeometry height="138" width="260" x="998" y="586" as="geometry" />
        </mxCell>
        <mxCell id="states" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=light-dark(#D5E8D4,#E0FFE1);strokeColor=#82b366;fontColor=light-dark(#000000,#000000);fontSize=13;arcSize=6;" value="&lt;b&gt;Payment states&lt;/b&gt;&lt;br&gt;pending → succeeded | expired&lt;br&gt;expired → succeeded&lt;br&gt;succeeded → partially_refunded → refunded&lt;br&gt;&lt;b&gt;Refund states:&lt;/b&gt; pending → processed | failed" vertex="1">
          <mxGeometry height="104" width="285" x="680" y="832" as="geometry" />
        </mxCell>
        <mxCell id="db" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=none;strokeColor=#4c7093;fontColor=light-dark(#000000,#000000);fontSize=13;" value="&lt;b&gt;Database&lt;/b&gt;&lt;br&gt;payments · refunds · idempotency_keys&lt;br&gt;processed_events · callback_outbox&lt;br&gt;Unique constraints + row locks for concurrency" vertex="1">
          <mxGeometry height="120" width="280" x="1123" y="911" as="geometry" />
        </mxCell>
        <mxCell id="flowNotes" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=light-dark(#DAE8FC,#E5E6ED);strokeColor=#6c8ebf;fontColor=light-dark(#000000,#000000);fontSize=13;arcSize=6;" value="&lt;b&gt;Happy path (card)&lt;/b&gt;&lt;br&gt;1. Marketly POST /payments&lt;br&gt;2. Save pending payment → Paystack initialize (ref = paymentId) → return checkoutUrl&lt;br&gt;3. Customer pays on Paystack hosted page&lt;br&gt;4. Paystack charge.success webhook → verify signature + verify API → mark succeeded&lt;br&gt;5. Write signed callback to outbox → deliver to Marketly" vertex="1">

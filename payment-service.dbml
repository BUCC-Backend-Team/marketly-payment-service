// Payment Service ER diagram - paste into https://dbdiagram.io
// Amounts are integers in kobo; currency is NGN only.

Enum payment_status {
  pending
  succeeded
  expired
  partially_refunded
  refunded
}

Enum refund_status {
  pending
  processed
  failed
}

Enum payment_channel {
  card
  bank_transfer
}

Enum callback_type {
  "payment.succeeded"
  "payment.expired"
  "payment.refunded"
  "payment.refund_failed"
}

Enum callback_status {
  pending
  delivered
  failed
}

Enum idempotency_scope {
  payment_create
  refund_create
}

Table payments {
  id uuid [primary key, note: 'Also used as the Paystack reference; created before calling Paystack']
  order_id varchar [not null, note: 'Marketly order ID']
  amount integer [not null, note: 'kobo']
  amount_refunded integer [not null, default: 0, note: 'Sum of processed refunds, kobo']
  currency varchar(3) [not null, default: 'NGN']
  status payment_status [not null, default: 'pending']
  channel payment_channel [note: 'Set once Paystack reports how the customer paid']
  customer_email varchar [not null]
  return_url varchar [not null]
  checkout_url varchar [note: 'Paystack authorization_url']
  paystack_reference varchar [unique, not null, note: 'Equals id']
  paystack_transaction_id varchar [note: 'data.id from Paystack']
  paid_at timestamp
  expired_at timestamp
  paid_late boolean [not null, default: false, note: 'True when succeeded after expiry']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    order_id [note: "Implement as a PARTIAL UNIQUE index in SQL WHERE status IN ('pending','succeeded') - 409 payment_exists only for those statuses (dbdiagram can't express partial indexes)"]
    (status, created_at) [name: 'idx_payments_status_created', note: 'Expiry/reconciliation job scan']
  }
}

Table refunds {
  id uuid [primary key]
  payment_id uuid [not null, ref: > payments.id]
  amount integer [not null, note: 'kobo']
  status refund_status [not null, default: 'pending', note: 'Pending refunds count against balance; failed release it']
  paystack_refund_id varchar [note: 'Used to match refund.processed / refund.failed']
  failure_reason varchar
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    payment_id
    paystack_refund_id
  }
}

Table idempotency_keys {
  id uuid [primary key]
  key varchar [not null, note: 'Idempotency-Key header']
  scope idempotency_scope [not null]
  request_hash varchar [not null, note: 'Hash of request body; mismatch -> 422']
  response_status integer [not null]
  response_body jsonb [not null, note: 'Saved response replayed with Idempotent-Replayed: true']
  payment_id uuid [ref: > payments.id, note: 'Set for payment_create keys']
  refund_id uuid [ref: > refunds.id, note: 'Set for refund_create keys']
  created_at timestamp [not null, default: `now()`]

  indexes {
    (scope, key) [unique, name: 'uniq_idempotency_scope_key']
  }
}

Table webhook_events {
  id uuid [primary key]
  dedup_key varchar [unique, not null, note: 'event:data.id - inserted in same transaction as state change']
  event_type varchar [not null, note: 'charge.success, refund.processed, refund.failed, other']
  paystack_reference varchar [note: 'Links to payments.paystack_reference']
  payment_id uuid [ref: > payments.id]
  refund_id uuid [ref: > refunds.id]
  payload jsonb [not null]
  processed_at timestamp [not null, default: `now()`]
}

Table callback_outbox {
  id uuid [primary key, note: 'Callback id; stays the same across retries']
  payment_id uuid [not null, ref: > payments.id]
  refund_id uuid [ref: > refunds.id]
  type callback_type [not null]
  payload jsonb [not null, note: '{ id, type, createdAt, data: { paymentId, orderId, status, amount, amountRefunded, currency, late } }']
  status callback_status [not null, default: 'pending']
  attempts integer [not null, default: 0, note: 'At least 6 attempts']
  next_attempt_at timestamp [not null, default: `now()`, note: 'Exponential backoff 1s, 2s, 4s...']
  last_error varchar
  last_attempt_at timestamp
  delivered_at timestamp
  created_at timestamp [not null, default: `now()`]

  indexes {
    (status, next_attempt_at) [name: 'idx_outbox_due', note: 'Worker polling']
    payment_id
  }
}
